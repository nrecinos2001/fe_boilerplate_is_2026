# URL base de la API (sin "auth/login")
API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Nombre del condominio que gestiona esta instalación (se muestra en toda la interfaz).
# Se incrusta al compilar: tras cambiarlo, reinicia `npm run dev` o vuelve a hacer `npm run build`.
NEXT_PUBLIC_CONDOMINIO=Mi condominio

# Moneda de todos los importes (código ISO 4217: USD, MXN, EUR…). Por defecto USD.
# Se incrusta al compilar: tras cambiarla, reinicia `npm run dev` o vuelve a hacer `npm run build`.
NEXT_PUBLIC_MONEDA=USD
# Solo producción: false permite la cookie de sesión por HTTP (despliegue sin TLS fuera de localhost).
# COOKIE_SECURE=false
